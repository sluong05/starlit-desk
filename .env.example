# Copy this file to .env.local and fill in values from https://cloud.livekit.io
# (Project → Settings → Keys). Never commit .env.local.

LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret

# Your LiveKit project URL, e.g. wss://starlit-desk-abc123.livekit.cloud
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
